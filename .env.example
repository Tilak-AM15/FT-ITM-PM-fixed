# Backend runtime
PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/pmtrackdb
DB_USERNAME=pmtrack
DB_PASSWORD=change-me

# Security
# Generate a random secret of at least 32 characters for production.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# CORS: comma-separated frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost

# Production should use false and provide a bootstrap admin.
APP_SEED_DEMO_DATA=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=change-this-password
APP_BOOTSTRAP_ADMIN_FULL_NAME=System Administrator

# Database schema
JPA_DDL_AUTO=update

APP_SCHEDULER_ZONE=Asia/Kolkata
